# Dula — local development environment (example).
# Copy to `.env` for local Docker Compose. NEVER put real secrets here or commit `.env`.
# These values are for LOCAL DEV ONLY. Production secrets come from Vault (see docs/10-Security/DataSecurity.md).

# ---- PostgreSQL ----
POSTGRES_USER=dula
POSTGRES_PASSWORD=dula_dev_password
POSTGRES_DB=dula
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Qdrant (vector store) ----
QDRANT_URL=http://localhost:6333

# ---- OpenSearch (search / log analytics) ----
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Dula_dev_Admin123!

# ---- MinIO (object storage, S3 API) ----
MINIO_ROOT_USER=dula
MINIO_ROOT_PASSWORD=dula_dev_password
MINIO_ENDPOINT=http://localhost:9000

# ---- Redpanda (Kafka API event backbone) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---- Keycloak (OIDC) ----
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=dula
KEYCLOAK_CLIENT_ID=dula-web

# ---- Platform API ----
PLATFORM_API_URL=http://localhost:8000
DULA_ENV=dev
LOG_LEVEL=INFO
