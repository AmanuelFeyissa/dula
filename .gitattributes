# Normalize line endings: store text as LF in the repo (cross-platform + Linux CI safety).
* text=auto eol=lf

# Shell scripts MUST be LF (they run in bash on Linux CI).
*.sh text eol=lf
Makefile text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary / model / data artifacts — never normalize.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.gguf binary
*.safetensors binary
*.bin binary
