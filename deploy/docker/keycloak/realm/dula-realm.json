{
  "realm": "dula",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "analyst", "description": "SOC analyst (see docs/02-Vision/TargetUsers.md)" },
      { "name": "hunter", "description": "Threat hunter" },
      { "name": "responder", "description": "Incident responder (may approve containment)" },
      { "name": "engineer", "description": "Detection / platform engineer" },
      { "name": "admin", "description": "Platform administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "dula-web",
      "name": "Dula Web UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "dula-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dula-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dula-api",
      "name": "Dula Platform API (resource server)",
      "enabled": true,
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "maya",
      "enabled": true,
      "email": "maya@example.test",
      "firstName": "Maya",
      "lastName": "Analyst",
      "emailVerified": true,
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [
        { "type": "password", "value": "maya", "temporary": false }
      ],
      "realmRoles": ["analyst"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "emailVerified": true,
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "raj",
      "enabled": true,
      "email": "raj@example.test",
      "firstName": "Raj",
      "lastName": "Responder",
      "emailVerified": true,
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [
        { "type": "password", "value": "raj", "temporary": false }
      ],
      "realmRoles": ["responder"]
    },
    {
      "username": "hana",
      "enabled": true,
      "email": "hana@example.test",
      "firstName": "Hana",
