# Dula web — local env (copy to .env.local). Dev only; never commit real secrets.
# AUTH_SECRET: generate one with `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=dev-only-change-me-please-32bytes-min
AUTH_URL=http://localhost:3000

KEYCLOAK_ISSUER=http://localhost:8080/realms/dula
KEYCLOAK_CLIENT_ID=dula-web
# Public client (PKCE) — leave empty:
KEYCLOAK_CLIENT_SECRET=

# Server-side calls to the Platform API:
PLATFORM_API_URL=http://localhost:8000
